rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leads are written/read exclusively via Admin SDK (server-side API routes)
    match /leads/{leadId} {
      allow read, write: if false;
    }

    // Services and packages are publicly readable for potential client-side rendering
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    // Consultations and campaigns are server-only
    match /consultations/{consultationId} {
      allow read, write: if false;
    }

    match /campaigns/{campaignId} {
      allow read, write: if false;
    }
  }
}
